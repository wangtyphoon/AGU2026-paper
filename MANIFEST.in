include README.md THIRD_PARTY_NOTICES.md CITATION_DRAFT.md references.bib .gitignore
include configs/*.example.json
include docs/DATA_SOURCES.md docs/ENVIRONMENTS.md docs/FIGURE_MAP.md
include docs/METRIC_DEFINITIONS.md docs/MODEL_ARCHITECTURE.md docs/MODIFICATIONS.md
include docs/OPEN_RESEARCH.md docs/TC_STRUCTURE_TEXT.md docs/VALIDATION.md docs/WORKFLOW.md
include provenance/changes.json provenance/files.json provenance/reference_sources.json provenance/sources.json
recursive-include tools *.py
recursive-include tests *.py
prune artifacts
prune qa
prune tmp
prune .codex_tmp_compare
prune .submission_qa
prune build
prune dist
prune .git
prune .venv
prune .vscode
global-exclude *.pyc *.pyo *.npy *.npz *.pt *.pth *.onnx *.nc *.grib *.grib2 *.csv *.png *.jpg *.jpeg *.svg *.pdf *.doc *.docx *.zip *.tar *.gz *.7z *.log
global-exclude *.local.* .env .env.* *.bak *.backup *.orig *.rej *~

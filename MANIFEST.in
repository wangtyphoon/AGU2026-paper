include README.md THIRD_PARTY_NOTICES.md CITATION_DRAFT.md references.bib .gitignore
recursive-include configs *.json
recursive-include docs *.md
recursive-include provenance *.json
recursive-include tools *.py
recursive-include tests *.py
prune artifacts
prune qa
prune build
prune .git
prune .venv
prune .vscode
global-exclude *.pyc *.pyo *.npy *.npz *.pt *.pth *.onnx *.nc *.grib *.png *.pdf *.log

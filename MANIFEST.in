include README.md THIRD_PARTY_NOTICES.md .gitignore
include configs/*.example.json
include docs/WORKFLOW.md docs/ENVIRONMENTS.md docs/DATA_SOURCES.md
include docs/METRIC_DEFINITIONS.md docs/FIGURE_MAP.md
include tools/run_curriculum.py
recursive-include tests *.py
prune WEIGHTING
prune plotting_data
prune provenance
prune artifacts
prune qa
prune tmp
prune .codex_tmp_compare
prune .submission_qa
prune build
prune dist
prune .git
prune .venv
prune .vscode
global-exclude *.pyc *.pyo *.npy *.npz *.pt *.pth *.onnx *.nc *.grib *.grib2 *.csv *.png *.jpg *.jpeg *.svg *.pdf *.doc *.docx *.zip *.tar *.gz *.7z *.log *.sha256
global-exclude *.local.* .env .env.* *.bak *.backup *.orig *.rej *~
